{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/documentation/get",
      "destination": "/api/get.js"
    },
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_ENGINE_API_URL/api/:path*"
    },
    {
      "source": "/ask",
      "destination": "https://YOUR_ENGINE_API_URL/ask"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}