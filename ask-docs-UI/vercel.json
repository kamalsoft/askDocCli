{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/documentation/get",
      "destination": "/api/get.js"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ask-doc-cli.vercel.app/api/:path*"
    },
    {
      "source": "/ask",
      "destination": "https://ask-doc-cli.vercel.app/ask"
    },
    {
      "source": "/ask-docs-UI/(.*)",
      "destination": "/index.html"
    }
  ]
}