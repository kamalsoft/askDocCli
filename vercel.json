{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR_ENGINE_API_URL/api/$1"
    },
    {
      "source": "/ask",
      "destination": "https://YOUR_ENGINE_API_URL/ask"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}